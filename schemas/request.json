{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuma request",
  "description": "`<name>.yaml`: one request. The file name (without `.yaml`) is the request's name.",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "default": "GET"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string"
    },
    "operation": {
      "description": "The OpenAPI operation this request calls, as `METHOD /path/{param}`, for sync and contract checks.",
      "type": [
        "string",
        "null"
      ]
    },
    "headers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/KeyValue"
      }
    },
    "body": {
      "$ref": "#/$defs/Body"
    },
    "auth": {
      "description": "Absent means inherit from the folder; `type: none` means send no auth.",
      "anyOf": [
        {
          "$ref": "#/$defs/Auth"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "expect": {
      "description": "Checks that `tuma test` and `tuma run` apply to the response.",
      "$ref": "#/$defs/Expectations"
    },
    "scripts": {
      "description": "Pre-request and test scripts (JavaScript, Postman's `pm.*` API). Collections and folders can have them too.",
      "$ref": "#/$defs/Scripts"
    },
    "messages": {
      "description": "For a WebSocket request (a `ws://` or `wss://` URL) or a streaming gRPC call: messages to send with a click.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SavedMessage"
      }
    },
    "grpc": {
      "description": "For a gRPC request (a `grpc://` or `grpcs://` URL): the method, and `.proto` files if the server has no\nreflection. The message is the JSON body.",
      "anyOf": [
        {
          "$ref": "#/$defs/GrpcSettings"
        },
        {
          "type": "null"
        }
      ]
    },
    "examples": {
      "description": "Responses saved as examples: they document the request, and mock servers answer with them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Example"
      }
    }
  },
  "$defs": {
    "KeyValue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "value": {
          "type": "string",
          "default": ""
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "Body": {
      "description": "A request body. Text bodies name their language (`type: json`) instead of a content type, because that is what\npeople pick in the UI.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "xml"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "html"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "javascript"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "description": "Text with any other content type.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "raw"
            },
            "content": {
              "type": "string"
            },
            "contentType": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content",
            "contentType"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "form"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/KeyValue"
              }
            }
          },
          "required": [
            "type",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "multipart"
            },
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Part"
              }
            }
          },
          "required": [
            "type",
            "parts"
          ]
        },
        {
          "description": "A GraphQL operation, sent as JSON (`{\"query\", \"variables\", \"operationName\"}`).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "graphql"
            },
            "query": {
              "type": "string"
            },
            "variables": {
              "description": "JSON text; `{{variables}}` are resolved before it is parsed.",
              "type": "string"
            },
            "operationName": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "query"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string"
            },
            "contentType": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "path"
          ]
        }
      ]
    },
    "Part": {
      "description": "A multipart field. With `file: true`, `value` is a file path.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "value": {
          "type": "string",
          "default": ""
        },
        "file": {
          "type": "boolean"
        },
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "Auth": {
      "description": "Auth as written in files. Same shapes as [`http::Auth`].",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "bearer"
            },
            "token": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "basic"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "username",
            "password"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "apiKey"
            },
            "key": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "location": {
              "$ref": "#/$defs/ApiKeyLocation",
              "default": "header"
            }
          },
          "required": [
            "type",
            "key",
            "value"
          ]
        },
        {
          "description": "HTTP Digest: answers the server's challenge.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "digest"
            }
          },
          "$ref": "#/$defs/DigestAuth",
          "required": [
            "type"
          ]
        },
        {
          "description": "AWS Signature Version 4.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aws"
            }
          },
          "$ref": "#/$defs/AwsAuth",
          "required": [
            "type"
          ]
        },
        {
          "description": "A JWT signed from a payload, sent as a bearer token.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "jwt"
            }
          },
          "$ref": "#/$defs/JwtAuth",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth1"
            }
          },
          "$ref": "#/$defs/OAuth1Auth",
          "required": [
            "type"
          ]
        },
        {
          "description": "Tokens are kept on this machine (in the keychain), not in the file.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth2"
            }
          },
          "$ref": "#/$defs/OAuth2Auth",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ApiKeyLocation": {
      "type": "string",
      "enum": [
        "header",
        "query"
      ]
    },
    "DigestAuth": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "default": ""
        },
        "password": {
          "type": "string",
          "default": ""
        }
      }
    },
    "AwsAuth": {
      "type": "object",
      "properties": {
        "accessKey": {
          "type": "string",
          "default": ""
        },
        "secretKey": {
          "type": "string",
          "default": ""
        },
        "sessionToken": {
          "description": "For temporary credentials.",
          "type": "string"
        },
        "region": {
          "description": "Such as `us-east-1`.",
          "type": "string",
          "default": ""
        },
        "service": {
          "description": "Such as `s3`, `execute-api` or `iam`.",
          "type": "string",
          "default": ""
        }
      }
    },
    "JwtAlgorithm": {
      "type": "string",
      "enum": [
        "HS256",
        "HS384",
        "HS512",
        "RS256",
        "RS384",
        "RS512",
        "PS256",
        "PS384",
        "PS512",
        "ES256",
        "ES384"
      ]
    },
    "JwtAuth": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/JwtAlgorithm",
          "default": "HS256"
        },
        "secret": {
          "description": "For HS algorithms, the shared secret; otherwise a PEM private key (PKCS#8, or PKCS#1 for RSA).",
          "type": "string",
          "default": ""
        },
        "secretBase64": {
          "description": "The HS secret is base64.",
          "type": "boolean"
        },
        "payload": {
          "description": "The claims, as JSON.",
          "type": "string",
          "default": "{}"
        },
        "headers": {
          "description": "Extra header fields, as JSON, such as `{\"kid\": \"key-1\"}`.",
          "type": "string"
        },
        "prefix": {
          "description": "Sent as `Authorization: <prefix> <token>`.",
          "type": "string",
          "default": "Bearer"
        },
        "queryParam": {
          "description": "Send the token as this query parameter instead of a header.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "OAuth1Method": {
      "type": "string",
      "enum": [
        "HMAC-SHA1",
        "HMAC-SHA256",
        "HMAC-SHA512",
        "PLAINTEXT"
      ]
    },
    "OAuth1Location": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "header",
            "query"
          ]
        },
        {
          "description": "In a form body (only for `application/x-www-form-urlencoded` requests).",
          "type": "string",
          "const": "body"
        }
      ]
    },
    "OAuth1Auth": {
      "type": "object",
      "properties": {
        "consumerKey": {
          "type": "string",
          "default": ""
        },
        "consumerSecret": {
          "type": "string",
          "default": ""
        },
        "token": {
          "type": "string"
        },
        "tokenSecret": {
          "type": "string"
        },
        "signatureMethod": {
          "$ref": "#/$defs/OAuth1Method",
          "default": "HMAC-SHA1"
        },
        "location": {
          "$ref": "#/$defs/OAuth1Location",
          "default": "header"
        },
        "realm": {
          "type": "string"
        },
        "callback": {
          "type": "string"
        },
        "verifier": {
          "type": "string"
        }
      }
    },
    "OAuth2Grant": {
      "oneOf": [
        {
          "description": "A browser login that returns a code, exchanged for a token (with PKCE when `pkce` is set).",
          "type": "string",
          "const": "authorizationCode"
        },
        {
          "description": "A browser login that returns the token directly. Old; prefer the code grant with PKCE.",
          "type": "string",
          "const": "implicit"
        },
        {
          "description": "The app's own credentials, no user.",
          "type": "string",
          "const": "clientCredentials"
        },
        {
          "description": "A user name and password sent to the token endpoint.",
          "type": "string",
          "const": "password"
        }
      ]
    },
    "ClientAuthentication": {
      "oneOf": [
        {
          "description": "The client id and secret as HTTP Basic auth.",
          "type": "string",
          "const": "header"
        },
        {
          "description": "The client id and secret in the form body.",
          "type": "string",
          "const": "body"
        }
      ]
    },
    "OAuth2Auth": {
      "type": "object",
      "properties": {
        "grant": {
          "$ref": "#/$defs/OAuth2Grant",
          "default": "authorizationCode"
        },
        "authUrl": {
          "description": "The login page, for the browser grants.",
          "type": "string"
        },
        "accessTokenUrl": {
          "description": "Where codes, credentials and refresh tokens are exchanged for tokens.",
          "type": "string"
        },
        "clientId": {
          "type": "string",
          "default": ""
        },
        "clientSecret": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "redirectUri": {
          "description": "For the browser grants: a loopback address Tuma listens on, registered with the provider.",
          "type": "string",
          "default": "http://localhost:8765/callback"
        },
        "pkce": {
          "description": "For the code grant: use PKCE (S256).",
          "type": "boolean",
          "default": true
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "clientAuthentication": {
          "$ref": "#/$defs/ClientAuthentication",
          "default": "header"
        },
        "prefix": {
          "description": "Sent as `Authorization: <prefix> <token>`.",
          "type": "string",
          "default": "Bearer"
        }
      }
    },
    "Settings": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "description": "Give up after this long, for the whole exchange including redirects. `None` waits forever.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "default": null
        },
        "followRedirects": {
          "type": "boolean",
          "default": true
        },
        "maxRedirects": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 10
        },
        "verifyTls": {
          "description": "Check the server's certificate against the operating system's trust store.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "Expectations": {
      "type": "object",
      "properties": {
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxTimeMs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HeaderCheck"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BodyCheck"
          }
        },
        "schema": {
          "description": "The response must match the OpenAPI spec for its operation and status (a contract check). Needs a collection\nimported from a spec.",
          "type": "boolean"
        }
      }
    },
    "Status": {
      "description": "An exact status code, or a class such as `2xx`.",
      "anyOf": [
        {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "string"
        }
      ]
    },
    "HeaderCheck": {
      "description": "A check on a response header. Names are case-insensitive. With no condition, the header must exist.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "equals": {
          "type": [
            "string",
            "null"
          ]
        },
        "contains": {
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "description": "`false` checks that the header is absent.",
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "BodyCheck": {
      "description": "A check on the body. `path` is a JSON path such as `$.items[0].id`; without one, the check applies to the whole\nbody as text (`contains`, `matches`) or as JSON (`equals`).",
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "equals": {
          "description": "Any JSON value. `1` and `\"1\"` are different."
        },
        "contains": {
          "type": [
            "string",
            "null"
          ]
        },
        "matches": {
          "description": "A regular expression the value (as text) must match.",
          "type": [
            "string",
            "null"
          ]
        },
        "length": {
          "description": "Number of items in an array or object, or characters in a string.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "type": {
          "description": "`string`, `number`, `integer`, `boolean`, `array`, `object` or `null`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Scripts": {
      "type": "object",
      "properties": {
        "preRequest": {
          "type": "string"
        },
        "test": {
          "type": "string"
        }
      }
    },
    "SavedMessage": {
      "description": "A WebSocket message kept with its request.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "content": {
          "description": "Text; `{{variables}}` are resolved when it is sent.",
          "type": "string",
          "default": ""
        }
      }
    },
    "GrpcSettings": {
      "description": "Where a request's method descriptions come from.",
      "type": "object",
      "properties": {
        "method": {
          "description": "The method to call, as `package.Service/Method`.",
          "type": "string",
          "default": ""
        },
        "protos": {
          "description": "`.proto` files, relative to the workspace. Empty: ask the server (reflection).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imports": {
          "description": "Folders imports are found in, relative to the workspace. The files' own folders are searched too.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Example": {
      "description": "A response kept with its request, for documentation and mock servers.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "status": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 200
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyValue"
          }
        },
        "body": {
          "type": "string"
        }
      }
    }
  }
}
