{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuma workspace.yaml",
  "description": "`workspace.yaml` at the workspace root.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": ""
    },
    "id": {
      "description": "Identifies the workspace in the OS keychain, so clones of the same repo share secrets on one machine.",
      "type": "string",
      "default": ""
    },
    "variables": {
      "description": "Global variables, the lowest-priority scope.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Variable"
      }
    },
    "order": {
      "description": "The collections' display order, by folder name, once they have been arranged; otherwise alphabetical.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "Variable": {
      "description": "A variable. A secret's value lives in the OS keychain, never in the file.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "value": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
