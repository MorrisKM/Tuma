{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuma environment (environments/<name>.yaml)",
  "description": "`environments/<name>.yaml`.",
  "type": "object",
  "properties": {
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Variable"
      }
    }
  },
  "$defs": {
    "Variable": {
      "description": "A variable. A secret's value lives in the OS keychain, never in the file.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": ""
        },
        "value": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
